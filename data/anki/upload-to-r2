def fetch_all_private_data(source_db):
    """Fetch all private/sensitive data from Anki DB."""
    conn = sqlite3.connect(source_db)
    conn.row_factory = sqlite3.Row
    cur = conn.cursor()
    
    # 1. Notes with full content (flds, tags, data)
    cur.execute("""
        SELECT id, guid, mid, flds, tags, data
        FROM notes
    """)
    notes = [dict(row) for row in cur.fetchall()]
    
    # 2. Cards with custom data field
    cur.execute("""
        SELECT id, nid, data
        FROM cards
        WHERE data != '' AND data IS NOT NULL
    """)
    cards_data = [dict(row) for row in cur.fetchall()]
    
    # 3. Notetypes (templates, CSS, fields - reveals content structure)
    cur.execute("""
        SELECT id, name, config
        FROM notetypes
    """)
    notetypes = []
    for row in cur.fetchall():
        notetype = dict(row)
        # Parse config JSON if present
        if notetype['config']:
            try:
                notetype['config'] = json.loads(notetype['config'])
            except Exception as e:
                print(f"Warning: Failed to parse notetype config JSON for ID {notetype.get('id')}: {e}")
                pass
        notetypes.append(notetype)
    
    # 4. Decks with full configuration
    cur.execute("""
        SELECT id, name, common, kind
        FROM decks
    """)
    decks_config = []
    for row in cur.fetchall():
        deck = {
            'id': row[0],
            'name': row[1],
            'common': row[2],
            'kind': row[3],
        }
        decks_config.append(deck)
    
    # 5. Media registry (file references, not actual files)
    # In newer Anki, media is stored in the 'col' table or 'config' table
    media_registry = {}
    
    # 6. Collection metadata from config table
    cur.execute("""
        SELECT key, val
        FROM config
    """)
    collection_config = {}
    for row in cur.fetchall():
        collection_config[row[0]] = row[1]
    
    conn.close()
    
    return {
        'notes': notes,
        'cards_data': cards_data,
        'notetypes': notetypes,
        'decks_config': decks_config,
        'media_registry': media_registry,
        'collection_config': collection_config,
        'exported_at': datetime.now().astimezone().isoformat(),
    }


def create_aws_signature(method, bucket, key, date, access_key, secret_key, content_hash):
    """Create AWS SigV4 signature for R2 (S3-compatible)."""
    import hmac
    from hashlib import sha256
    
    service = 's3'
    region = 'auto'
    
    canonical_uri = f'/{key}'
    canonical_querystring = ''
    canonical_headers = f'host:{access_key}.r2.cloudflarestorage.com\nx-amz-content-sha256:{content_hash}\nx-amz-date:{date}\n'
    signed_headers = 'host;x-amz-content-sha256;x-amz-date'
    
    canonical_request = f'{method}\n{canonical_uri}\n{canonical_querystring}\n{canonical_headers}\n{signed_headers}\n{content_hash}'
    
    algorithm = 'AWS4-HMAC-SHA256'
    date_stamp = date[:8]
    credential_scope = f'{date_stamp}/{region}/{service}/aws4_request'
    string_to_sign = f'{algorithm}\n{date}\n{credential_scope}\n{sha256(canonical_request.encode()).hexdigest()}'
    
    def sign(key, msg):
        return hmac.new(key, msg.encode('utf-8'), sha256).digest()
    
    k_date = sign(('AWS4' + secret_key).encode(), date_stamp)
    k_region = sign(k_date, region)
    k_service = sign(k_region, service)
    k_signing = sign(k_service, 'aws4_request')
    signature = hmac.new(k_signing, string_to_sign.encode('utf-8'), sha256).hexdigest()
    
    return f'{algorithm} Credential={access_key}/{credential_scope}, SignedHeaders={signed_headers}, Signature={signature}'


_s3_client = None
_s3_client_key = None


def get_s3_client(creds):
    """Return a cached boto3 S3 client for these creds and proxy settings.

    A fresh client per upload means a new connection pool — DNS + TCP + TLS
    per file, which dominated per-note upload time on a slow link. The cache
    key includes the proxy env vars because botocore only reads them at
    client creation, so enable_proxy_fallback()'s env change transparently
    invalidates the cache and the next call builds a rerouted client.
    """
    global _s3_client, _s3_client_key
    key = (
        creds['account_id'],
        creds['access_key'],
        os.environ.get('HTTPS_PROXY') or os.environ.get('https_proxy'),
    )
    if _s3_client is None or _s3_client_key != key:
        _s3_client = boto3.client(
            's3',
            endpoint_url=f"https://{creds['account_id']}.r2.cloudflarestorage.com",
            aws_access_key_id=creds['access_key'],
            aws_secret_access_key=creds['secret_key'],
            config=Config(
                signature_version='s3v4',
                retries={'max_attempts': 3, 'mode': 'standard'},
                connect_timeout=120,
                read_timeout=120
            )
        )
        _s3_client_key = key
    return _s3_client


def upload_to_r2(bucket, key, data, creds, verbose=False, max_retries=3, quiet=False):
    """Upload data to R2 bucket using boto3 (preferred) or urllib."""
    account_id = creds['account_id']
    access_key = creds['access_key']
    secret_key = creds['secret_key']
    
    # Prepare data
    if isinstance(data, (dict, list)):
        content = json.dumps(data, ensure_ascii=False, default=str).encode('utf-8')
    else:
        content = data
    
    # Compress
    content_gz = gzip.compress(content)
    
    if HAS_BOTO3:
        # Use boto3 for better reliability. botocore reads HTTPS_PROXY from
        # the env when the client is created, so a proxy enabled mid-run by
        # enable_proxy_fallback() applies to the retry and all later clients.
        for retry_with_proxy in (False, True):
            try:
                s3_client = get_s3_client(creds)

                s3_client.put_object(
                    Bucket=bucket,
                    Key=key,
                    Body=content_gz,
                    ContentEncoding='gzip'
                )

                if verbose and not quiet:
                    print(f"  ✓ Uploaded {key} ({len(content_gz):,} bytes)")
                return True, len(content_gz)
            except Exception as e:
                if not retry_with_proxy and enable_proxy_fallback():
                    continue
                if verbose and not quiet:
                    print(f"  ⚠ boto3 failed for {key}: {e}, trying urllib...")
                break
        # Don't return False here, let urllib try

    # Fallback to urllib
    from urllib.request import Request, urlopen, ProxyHandler, build_opener, install_opener
    endpoint = f'https://{account_id}.r2.cloudflarestorage.com/{bucket}/{key}'
    content_hash = hashlib.sha256(content_gz).hexdigest()
    amz_date = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    authorization = create_aws_signature(
        'PUT', bucket, key, amz_date, access_key, secret_key, content_hash
    )
    
    for attempt in range(max_retries):
        try:
            req = Request(
                endpoint,
                data=content_gz,
                method='PUT',
                headers={
                    'Authorization': authorization,
                    'x-amz-content-sha256': content_hash,
                    'x-amz-date': amz_date,
                    'Content-Encoding': 'gzip',
                    'Content-Length': str(len(content_gz)),
                    'Content-Type': 'application/octet-stream',
                }
            )
            
            response = urlopen(req, timeout=120)
            if verbose and not quiet:
                print(f"  ✓ Uploaded {key} ({len(content_gz):,} bytes)")
            return True, len(content_gz)
        except Exception as e:
            if enable_proxy_fallback():
                # urlopen caches its opener at first use; rebuild it so the
                # freshly exported HTTPS_PROXY takes effect on the retry.
                install_opener(build_opener(ProxyHandler()))
            if attempt < max_retries - 1:
                if verbose and not quiet:
                    print(f"  ⚠ Retry {key} (attempt {attempt + 2}/{max_retries}): {e}")
                import time
                time.sleep(1)
            else:
                if not quiet:
                    print(f"  ✗ Failed to upload {key} after {max_retries} attempts: {e}")
                return False, 0
    
    return False, 0


def upload_from_staging(staging_dir, creds, verbose, notes_count, sync=False):
    """Upload already staged files to R2. Returns the set of keys that
    failed to upload, so callers keep them out of the hash map."""
    uploaded_count = 0
    failed_count = 0
    failed_keys = set()
    total_bytes = 0
    total_files = 0
    
    # Collection files
    collection_files = [
        'collection/notes.json.gz',
        'collection/cards.json.gz',
        'collection/reviews.json.gz',
        'collection/notetypes.json.gz',
        'collection/decks.json',
        'collection/cards-data.json.gz',
        'collection/media-registry.json',
        'collection/collection-config.json',
    ]
    
    # Count total files first
    total_files = len([f for f in collection_files if (staging_dir / f).exists()])
    total_files += notes_count  # Individual notes
    
    print(f"\n📤 Uploading {total_files:,} files to R2...")
    
    # Upload collection files
    for i, key in enumerate(collection_files, 1):
        local_path = staging_dir / key
        if not local_path.exists():
            if verbose:
                print(f"   ⊘ Skipped {key} (not found)")
            continue
        
        with open(local_path, 'rb') as f:
            content = f.read()
        
        success, size = upload_to_r2(creds['bucket'], key, content, creds, verbose)
        if success:
            uploaded_count += 1
            total_bytes += size
        else:
            failed_count += 1
            failed_keys.add(key)

        # Progress for collection files
        if verbose:
            progress = (i / total_files) * 100 if total_files > 0 else 0
            print(f"   Progress: {i:,}/{total_files:,} ({progress:.1f}%)")
    
    # Get list of local note files
    notes_dir = staging_dir / "notes"
    
    # Sync: List R2 and delete orphaned notes
    if sync and HAS_BOTO3:
        print(f"\n🔄 Syncing R2 with local notes...")
        local_notes = {f.name for f in notes_dir.glob("*.json.gz")}
        deleted_count = sync_r2_notes(creds, local_notes, verbose)
        if verbose and deleted_count > 0:
            print(f"   🗑️  Deleted {deleted_count} orphaned notes from R2")
    elif sync and not HAS_BOTO3:
        print(f"\n⚠️  Sync requires boto3. Install with: pip install boto3")
    
    # Upload individual notes with progress bar
    print(f"\n📤 Uploading {notes_count:,} individual notes...")
    
    note_files = sorted(notes_dir.glob("*.json.gz"))
    
    for i, note_file in enumerate(note_files, 1):
        key = f"notes/{note_file.name}"
        
        with open(note_file, 'rb') as f:
            content = f.read()
        
        # Upload each file and show progress
        success, size = upload_to_r2(creds['bucket'], key, content, creds, verbose=False, quiet=True)
        if success:
            uploaded_count += 1
            total_bytes += size
        else:
            failed_count += 1
            failed_keys.add(key)

        # Show progress every 100 files (fast enough to not slow down, frequent enough to see movement)
        if i % 100 == 0 or i == notes_count:
            progress = (i / notes_count) * 100 if notes_count > 0 else 0
            bar_width = 40
            filled = int(bar_width * i / notes_count) if notes_count > 0 else 0
            bar = '█' * filled + '░' * (bar_width - filled)
            # Use carriage return to update in place
            print(f"\r   [{bar}] {i:,}/{notes_count:,} ({progress:.1f}%)", end='', flush=True)
    
    # Final newline
    print()
    
    print()
    print(f"✅ Done! {uploaded_count:,}/{total_files:,} files uploaded ({total_bytes/1024/1024:.1f} MB)")
    if failed_count > 0:
        print(f"   ⚠️  {failed_count} failed — kept out of the hash map; rerun to retry them")
    print(f"\n   Staged files kept in: {staging_dir}")
    print("   (You can delete this folder after verifying upload)")
    return failed_keys


def sync_r2_notes(creds, local_notes, verbose=False):
    """Delete notes from R2 that don't exist locally."""
    if not HAS_BOTO3:
        return 0

    try:
        s3_client = get_s3_client(creds)

        # List all objects in notes/ prefix
        paginator = s3_client.get_paginator('list_objects_v2')
        pages = paginator.paginate(Bucket=creds['bucket'], Prefix='notes/')
        
        to_delete = []
        for page in pages:
            if 'Contents' not in page:
                continue
            for obj in page['Contents']:
                key = obj['Key']
                # Extract filename from key
                filename = key.split('/')[-1]
                if filename and filename not in local_notes:
                    to_delete.append({'Key': key})
        
        if not to_delete:
            if verbose:
                print(f"   ✓ No orphaned notes to delete")
            return 0
        
        # Delete in batches of 1000 (S3 API limit)
        deleted_count = 0
        for i in range(0, len(to_delete), 1000):
            batch = to_delete[i:i+1000]
            response = s3_client.delete_objects(
                Bucket=creds['bucket'],
                Delete={'Objects': batch}
            )
            deleted_count += len(batch)
            if verbose:
                print(f"   🗑️  Deleted {deleted_count}/{len(to_delete)} orphaned notes...")
        
        return deleted_count
        
    except Exception as e:
        if verbose:
            print(f"   ⚠️  Sync failed: {e}")
        return 0


def main():
    parser = argparse.ArgumentParser(
        prog='upload-to-r2',
        description='Upload full private Anki content to Cloudflare R2',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
R2 Directory Structure:
  anki-content/
  ├── collection/
  │   ├── notes.json.gz           # All notes with flds, tags
  │   ├── cards-data.json.gz      # Cards with custom data
  │   ├── notetypes.json.gz       # Templates, CSS
  │   ├── decks-config.json.gz    # Deck configurations
  │   ├── media-registry.json     # Media references
  │   └── collection-config.json  # Collection metadata
  └── notes/
      ├── {guid1}.json.gz         # Individual note lookup
      ├── {guid2}.json.gz
      └── ...
        """
    )
    parser.add_argument('-v', '--verbose', action='store_true', help='Show detailed output')
    parser.add_argument('-d', '--dry-run', action='store_true', help='Show what would be uploaded')
    parser.add_argument('-f', '--force', action='store_true', help='Re-upload everything (deprecated, use --full)')
    parser.add_argument('--full', action='store_true', help='Force full upload (ignore hash map)')
    parser.add_argument('-q', '--quiet', action='store_true', help='Minimal output')
    parser.add_argument('--upload-only', action='store_true', help='Upload already staged files (skip staging)')
    parser.add_argument('--stage-only', action='store_true', help='Only stage files (skip upload prompt)')
    parser.add_argument('--sync', action='store_true', help='Sync R2 with local (delete orphaned notes)')

    args = parser.parse_args()

    # Support deprecated -f/--force as alias for --full
    if args.force:
        args.full = True

    # Import hash map module for incremental uploads
    # Script is at data/anki/upload-to-r2, hash_map is at graph/hash_map.py
    script_dir = Path(__file__).parent
    project_root = script_dir.parent.parent
    sys.path.insert(0, str(project_root / 'graph'))
    from hash_map import compute_note_hash, load_hash_map, save_hash_map, find_changed_notes, update_hash_map

    # Load credentials (not required for dry run)
    creds = load_credentials()

    # Handle --upload-only (skip staging, just upload)
    if args.upload_only:
        staging_dir = get_staging_dir()
        if not (staging_dir / "collection" / "notes.json.gz").exists():
            print("❌ Error: No staged files found in", staging_dir, file=sys.stderr)
            print("   Run without --upload-only first to stage files.", file=sys.stderr)
            sys.exit(1)

        if not creds['account_id'] or not creds['access_key'] or not creds['secret_key']:
            print("❌ Error: R2 credentials not found", file=sys.stderr)
            sys.exit(1)

        if args.verbose:
            print(f"📦 R2 Bucket: {mask_value(creds['bucket'])}")  # codeql[py/clear-text-logging-sensitive-info] Masked values used for display
            print(f"   Account: {mask_value(creds['account_id'])}")  # codeql[py/clear-text-logging-sensitive-info] Masked values used for display
            print(f"   Staging: {staging_dir}")

        # Load hash map to determine what needs upload
        hash_map_file = staging_dir / "hash_map.json"
        old_hash_map = load_hash_map(hash_map_file)

        # Helper to check if file needs upload
        def file_needs_upload(key, file_path):
            """Check if file needs to be uploaded based on hash."""
            if not file_path.exists():
                return False, None
            
            with open(file_path, 'rb') as f:
                content = f.read()
            current_hash = hashlib.sha256(content).hexdigest()
            old_hash = old_hash_map.get(key)
            return old_hash is None or old_hash != current_hash, current_hash

        # Check collection files
        collection_files = [
            'collection/notes.json.gz',
            'collection/cards.json.gz',
            'collection/reviews.json.gz',
            'collection/notetypes.json.gz',
            'collection/decks.json',
            'collection/cards-data.json.gz',
            'collection/media-registry.json',
            'collection/collection-config.json',
        ]

        files_to_upload = []
        new_collection_hashes = {}

        for key in collection_files:
            file_path = staging_dir / key
            needs_upload, current_hash = file_needs_upload(key, file_path)
            if current_hash:
                new_collection_hashes[key] = current_hash
            if needs_upload:
                files_to_upload.append(('collection', key, file_path))
                if args.verbose:
                    print(f"   📤 {key} [CHANGED/NEW]")
            elif args.verbose:
                print(f"   ⊘ {key} [ALREADY UPLOADED]")

        # Check individual notes
        notes_dir = staging_dir / "notes"
        notes_to_upload = []
        
        if notes_dir.exists():
            note_files = list(notes_dir.glob("*.json.gz"))
            
            if args.verbose:
                print(f"\n   Checking {len(note_files):,} staged notes...")
            
            for note_file in note_files:
                # Read note to get GUID for hash lookup
                try:
                    with gzip.open(note_file, 'rt', encoding='utf-8') as f:
                        content = f.read()
                        if not content:
                            continue
                        note = json.loads(content)
                        guid = note.get('guid')
                        if not guid:
                            continue
                    
                    # Check if this note was already uploaded
                    old_hash = old_hash_map.get(guid)
                    current_hash = compute_note_hash(note)
                    
                    if old_hash is None or old_hash != current_hash:
                        notes_to_upload.append((guid, note_file, current_hash))
                except Exception as e:
                    # Corrupted file, skip
                    print(f"Warning: Failed to process note {note_file}: {e}")
                    continue
            
            if args.verbose:
                print(f"   📤 {len(notes_to_upload):,} notes need upload")
                print(f"   ⊘ {len(note_files) - len(notes_to_upload):,} notes already uploaded")

        # Upload only changed files
        total_to_upload = len(files_to_upload) + len(notes_to_upload)
        
        if total_to_upload == 0:
            print(f"\n✅ All files already uploaded to R2 - nothing to do")
            return
        
        print(f"\n📤 Uploading {total_to_upload:,} changed/new files to R2...")

        failed_keys = set()

        # Upload collection files
        for file_type, key, file_path in files_to_upload:
            with open(file_path, 'rb') as f:
                content = f.read()
            success, size = upload_to_r2(creds['bucket'], key, content, creds, args.verbose)
            if not success:
                failed_keys.add(key)
                print(f"   ✗ Failed to upload {key}")

        # Upload individual notes
        for i, (guid, note_file, current_hash) in enumerate(notes_to_upload, 1):
            key = f"notes/{note_file.name}"
            with open(note_file, 'rb') as f:
                content = f.read()
            success, size = upload_to_r2(creds['bucket'], key, content, creds, args.verbose, quiet=True)
            if not success:
                failed_keys.add(guid)

            # Progress
            if i % 100 == 0 or i == len(notes_to_upload):
                progress = (i / len(notes_to_upload)) * 100 if notes_to_upload else 0
                bar_width = 40
                filled = int(bar_width * i / len(notes_to_upload)) if notes_to_upload else 0
                bar = '█' * filled + '░' * (bar_width - filled)
                print(f"\r   [{bar}] {i:,}/{len(notes_to_upload):,} ({progress:.1f}%)", end='', flush=True)
        
        if notes_to_upload:
            print()  # Newline after progress

        # Update hash map with successful uploads only, so failed files are
        # retried on the next run instead of being silently skipped.
        new_hash_map = dict(old_hash_map)
        new_hash_map.update(
            {k: v for k, v in new_collection_hashes.items() if k not in failed_keys}
        )
        for guid, _, current_hash in notes_to_upload:
            if guid not in failed_keys:
                new_hash_map[guid] = current_hash
        save_hash_map(new_hash_map, hash_map_file)

        if args.verbose:
            print(f"\n   ✓ Updated hash map ({len(new_hash_map):,} entries)")

        print(f"\n✅ Done! Uploaded {total_to_upload - len(failed_keys):,}/{total_to_upload:,} files")
        if failed_keys:
            print(f"⚠️  {len(failed_keys)} upload(s) failed — kept out of the hash map; rerun to retry them")
        return

    if not args.dry_run:
        if not creds['account_id'] or not creds['access_key'] or not creds['secret_key']:
            print("❌ Error: R2 credentials not found", file=sys.stderr)
            print("\nSet credentials via:", file=sys.stderr)
            print("  1. Environment variables: R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY", file=sys.stderr)
            print("  2. Or create ~/.anki-r2/credentials file", file=sys.stderr)
            sys.exit(1)

    if args.verbose and creds['account_id']:
        print(f"📦 R2 Bucket: {mask_value(creds['bucket'])}")  # codeql[py/clear-text-logging-sensitive-info] Masked values used for display
        print(f"   Account: {mask_value(creds['account_id'])}")  # codeql[py/clear-text-logging-sensitive-info] Masked values used for display
    
    # Find Anki DB
    try:
        source_db = find_anki_db()
        if args.verbose:
            print(f"   Source: {source_db}")
    except RuntimeError as e:
        print(f"❌ Error: {e}", file=sys.stderr)
        sys.exit(1)
    
    # Fetch all private data
    if not args.quiet:
        print("📊 Fetching private data from Anki...")

    data = fetch_all_private_data(source_db)

    if args.verbose:
        print(f"   Notes: {len(data['notes']):,}")
        print(f"   Cards with data: {len(data['cards_data']):,}")
        print(f"   Notetypes: {len(data['notetypes']):,}")
        print(f"   Decks: {len(data['decks_config']):,}")
        print(f"   Media entries: {len(data['media_registry']):,}")

    # Get staging directory
    staging_dir = get_staging_dir()
    if args.verbose:
        print(f"   Staging: {staging_dir}")

    # Hash map file for incremental uploads
    hash_map_file = staging_dir / "hash_map.json"

    # Load previous hash map (for incremental uploads)
    if args.full:
        old_hash_map = {}
        if args.verbose:
            print("   Full upload mode (ignoring hash map)")
    else:
        old_hash_map = load_hash_map(hash_map_file)
        if args.verbose and old_hash_map:
            print(f"   Loaded hash map with {len(old_hash_map):,} entries")

    # Find changed notes (incremental upload)
    if not args.full and old_hash_map:
        changed_notes, unchanged_notes = find_changed_notes(data['notes'], old_hash_map)
        if not args.quiet:
            print(f"   New/changed notes: {len(changed_notes):,} / {len(data['notes']):,}")
            if unchanged_notes:
                print(f"   Unchanged notes (skipped): {len(unchanged_notes):,}")
    else:
        changed_notes = data['notes']
        unchanged_notes = []

    # Collection files with their data
    collection_files = [
        ('collection/notes.json.gz', data['notes']),
        ('collection/cards-data.json.gz', data['cards_data']),
        ('collection/notetypes.json.gz', data['notetypes']),
        ('collection/decks-config.json.gz', data['decks_config']),
        ('collection/media-registry.json', data['media_registry']),
        ('collection/collection-config.json', data['collection_config']),
    ]

    # Compute hashes for collection files and detect changes
    collection_hashes = {}
    changed_collection_files = []
    unchanged_collection_files = []
    
    for key, content in collection_files:
        if isinstance(content, (dict, list)):
            content_str = json.dumps(content, sort_keys=True, ensure_ascii=False, default=str).encode('utf-8')
        else:
            content_str = content if isinstance(content, bytes) else str(content).encode('utf-8')
        
        current_hash = hashlib.sha256(content_str).hexdigest()
        collection_hashes[key] = current_hash
        
        old_hash = old_hash_map.get(key) if old_hash_map else None
        if old_hash is None or old_hash != current_hash:
            changed_collection_files.append((key, content))
        else:
            unchanged_collection_files.append((key, content))
    
    if not args.full and old_hash_map and not args.quiet:
        print(f"   Changed collection files: {len(changed_collection_files)}/{len(collection_files)}")
        if unchanged_collection_files:
            print(f"   Unchanged collection files (skipped): {[k for k, _ in unchanged_collection_files]}")

    # Files to stage locally and upload
    uploads = changed_collection_files

    # Dry run
    if args.dry_run:
        print("\n🔍 Dry run - would stage and upload:")
        for key, content in uploads:
            if isinstance(content, list):
                print(f"   {key} ({len(content):,} items)")
            elif isinstance(content, dict):
                print(f"   {key} ({len(content):,} keys)")

        # Individual notes
        upload_count = len(changed_notes) if not args.full and old_hash_map else len(data['notes'])
        print(f"   notes/{{guid}}.json.gz ({upload_count:,} files)")
        print()

        # Estimate sizes
        total_uncompressed = 0
        for key, content in uploads:
            json_str = json.dumps(content, ensure_ascii=False, default=str)
            total_uncompressed += len(json_str.encode('utf-8'))

        print(f"   Estimated uncompressed: {total_uncompressed/1024/1024:.1f} MB")
        print(f"   Estimated compressed: ~{total_uncompressed/1024/1024*0.3:.1f} MB")
        return

    # Stage collection files locally first
    print(f"\n📁 Staging files in {staging_dir}...")

    for key, content in uploads:
        if not content:
            if args.verbose:
                print(f"   ⊘ Skipped {key} (empty)")
            continue

        # Create local file path
        local_path = staging_dir / key
        local_path.parent.mkdir(parents=True, exist_ok=True)

        # Write compressed file
        if isinstance(content, (dict, list)):
            json_str = json.dumps(content, ensure_ascii=False, default=str).encode('utf-8')
        else:
            json_str = content

        content_gz = gzip.compress(json_str)
        with open(local_path, 'wb') as f:
            f.write(content_gz)

        if args.verbose:
            print(f"   ✓ Staged {key} ({len(content_gz):,} bytes)")

    # Stage individual notes (only changed notes for incremental upload)
    notes_to_upload = changed_notes if not args.full and old_hash_map else data['notes']

    if args.verbose:
        print(f"\n   Staging individual notes ({len(notes_to_upload):,} to upload)...")

    notes_dir = staging_dir / "notes"
    notes_dir.mkdir(exist_ok=True)

    # Clean up unchanged note files from staging (for incremental uploads)
    if not args.full and old_hash_map and unchanged_notes:
        # Remove unchanged note files from staging directory
        for note in unchanged_notes:
            guid_hash = hashlib.md5(note['guid'].encode()).hexdigest()[:16]
            note_file = notes_dir / f"{guid_hash}.json.gz"
            if note_file.exists():
                note_file.unlink()

    staging_errors = []
    for i, note in enumerate(notes_to_upload):
        try:
            # GUID may contain special chars, use hash for filename
            guid_hash = hashlib.md5(note['guid'].encode()).hexdigest()[:16]
            local_path = notes_dir / f"{guid_hash}.json.gz"
            note_data = {
                'guid': note['guid'],
                'mid': note['mid'],
                'flds': note['flds'],
                'tags': note['tags'],
                'data': note['data'],
            }
            json_str = json.dumps(note_data, ensure_ascii=False, default=str).encode('utf-8')
            content_gz = gzip.compress(json_str)
            with open(local_path, 'wb') as f:
                f.write(content_gz)
        except Exception as e:
            staging_errors.append((note.get('guid', 'unknown'), str(e)))

        # Progress indicator
        if (i + 1) % 5000 == 0:
            print(f"   Progress: {i + 1:,}/{len(notes_to_upload):,} notes")

    # Report staging errors
    if staging_errors:
        print(f"\n   ⚠️  {len(staging_errors)} error(s) while staging notes:")
        for guid, error in staging_errors[:10]:
            print(f"      - {guid}: {error}")
        if len(staging_errors) > 10:
            print(f"      ... and {len(staging_errors) - 10} more")
        print(f"   ⚠️  Some notes were NOT staged - check errors above")

    notes_staged = len(notes_to_upload) - len(staging_errors)
    print(f"\n   ✓ Staged {notes_staged:,}/{len(notes_to_upload):,} individual notes")

    # If --stage-only, skip upload prompt (don't update hash map yet)
    if args.stage_only:
        print(f"\n✅ Files staged in: {staging_dir}")
        if staging_errors:
            print(f"   ⚠️  {len(staging_errors)} note(s) failed to stage")
        print("   (Run 'upload-to-r2 --upload-only' to upload)")
        return

    # Ask before uploading
    print()
    print("📤 Upload to R2?")
    print(f"   Bucket: {mask_value(creds['bucket'])}")  # codeql[py/clear-text-logging-sensitive-info] Masked values used for display
    print(f"   Account: {mask_value(creds['account_id'])}")  # codeql[py/clear-text-logging-sensitive-info] Masked values used for display
    print()
    response = input("   Type 'yes' to upload, or press Enter to skip: ")

    if response.strip().lower() != 'yes':
        print("\n   ⊘ Upload skipped. Files staged in:", staging_dir)
        print("\n   To upload later, run:")
        print(f"   ./upload-to-r2 --upload-only")
        return

    # Upload from staging (only changed notes)
    print(f"\n📤 Uploading from staging directory...")
    failed_keys = upload_from_staging(
        staging_dir, creds, args.verbose, len(notes_to_upload), sync=args.sync
    )

    # Update hash map with successful uploads only, so failed files are
    # retried on the next run instead of being silently skipped.
    if not args.full:
        failed_guids = {
            k[len('notes/'):-len('.json.gz')] for k in failed_keys if k.startswith('notes/')
        }

        # Start with old hash map
        new_hash_map = dict(old_hash_map)

        # Update note hashes
        new_hash_map = update_hash_map(
            new_hash_map, [n for n in data['notes'] if n.get('guid') not in failed_guids]
        )

        # Update collection file hashes
        new_hash_map.update(
            {k: v for k, v in collection_hashes.items() if k not in failed_keys}
        )

        save_hash_map(new_hash_map, hash_map_file)
        if args.verbose:
            print(f"\n   ✓ Updated hash map ({len(new_hash_map):,} entries)")


if __name__ == "__main__":
    main()
