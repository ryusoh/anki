def mask_value(value, visible_chars=8):
    """Mask sensitive value showing only start and end."""
    if not value or len(value) <= visible_chars * 2:
        return "********"
    return f"{value[:visible_chars]}...{value[-4:]}"


def load_credentials():
    """Load R2 credentials from environment or file."""
    creds = {
        'account_id': os.environ.get('R2_ACCOUNT_ID'),
        'access_key': os.environ.get('R2_ACCESS_KEY_ID'),
        'secret_key': os.environ.get('R2_SECRET_ACCESS_KEY'),
        'bucket': os.environ.get('R2_BUCKET', 'anki-content'),
    }
    
    # Fallback to file if env vars not set
    if not creds['account_id']:
        cred_file = Path.home() / '.anki-r2' / 'credentials'
        if cred_file.exists():
            for line in cred_file.read_text().strip().split('\n'):
                if '=' in line:
                    key, value = line.split('=', 1)
                    key = key.strip().lower()
                    if key == 'r2_account_id':
                        creds['account_id'] = value.strip()
                    elif key == 'r2_access_key_id':
                        creds['access_key'] = value.strip()
                    elif key == 'r2_secret_access_key':
                        creds['secret_key'] = value.strip()
                    elif key == 'r2_bucket':
                        creds['bucket'] = value.strip()
    
    return creds


# Well-known localhost HTTP-proxy ports probed when a direct upload fails:
# Clash Verge mixed port, Clash mixed port, ShadowsocksX-NG HTTP, Privoxy.
LOCAL_PROXY_PORTS = (7897, 7890, 1087, 8118)

PROXY_ENV_VARS = ('HTTPS_PROXY', 'https_proxy', 'HTTP_PROXY', 'http_proxy')


def _probe_proxy(proxy_url):
    """Return True if the proxy URL accepts TCP connections."""
    import socket
    from urllib.parse import urlparse
    parsed = urlparse(proxy_url if '://' in proxy_url else f'http://{proxy_url}')
    if not parsed.hostname:
        return False
    try:
        with socket.create_connection((parsed.hostname, parsed.port or 80), timeout=0.3):
            return True
    except OSError:
        return False


def detect_local_proxy(ports=LOCAL_PROXY_PORTS):
    """Return a live local HTTP proxy URL worth falling back to, or None."""
    import socket
    for port in ports:
        try:
            with socket.create_connection(('127.0.0.1', port), timeout=0.3):
                return f'http://127.0.0.1:{port}'
        except OSError:
            continue
    return None


def enable_proxy_fallback():
    """Repair the proxy environment after a failed upload attempt.

    - No proxy configured: probe for a live local proxy and export it.
    - Configured proxy dead (e.g. a stale HTTPS_PROXY export pointing at a
      stopped Clash): drop it, switch to a live local proxy if one exists,
      otherwise retry with a direct connection.

    Returns a truthy value if the environment changed (caller should retry
    with a fresh client/opener), else None.
    """
    current = os.environ.get('HTTPS_PROXY') or os.environ.get('https_proxy')
    if current:
        if _probe_proxy(current):
            return None  # proxy is alive; the failure lies elsewhere
        for var in PROXY_ENV_VARS:
            os.environ.pop(var, None)
        proxy = detect_local_proxy()
        if proxy:
            os.environ['HTTPS_PROXY'] = proxy
            os.environ['HTTP_PROXY'] = proxy
            print(f"  🔀 Proxy {current} unreachable — switching to local proxy {proxy}")
        else:
            print(f"  🔀 Proxy {current} unreachable — retrying with a direct connection")
        return proxy or 'direct'
    proxy = detect_local_proxy()
    if proxy:
        os.environ['HTTPS_PROXY'] = proxy
        os.environ['HTTP_PROXY'] = proxy
        print(f"  🔀 Direct connection failed — retrying via local proxy {proxy}")
    return proxy


