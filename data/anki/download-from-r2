#!/usr/bin/env python3
"""
download-from-r2 - Download note content from Cloudflare R2

Usage:
    download-from-r2 <guid> [options]

Examples:
    download-from-r2 hNb(y8)oa* --verbose
    download-from-r2 hNb(y8)oa* --output note.json
"""

import sys
import json
import gzip
import argparse
from pathlib import Path
from urllib.request import Request, urlopen
from urllib.error import HTTPError
import os
import hashlib
from datetime import datetime


def mask_value(value, visible_chars=8):
    """Mask sensitive value showing only start and end."""
    if not value or len(value) <= visible_chars * 2:
        return "********"
    return f"{value[:visible_chars]}...{value[-4:]}"


def load_credentials():
    """Load R2 credentials from environment or file."""
    creds = {
        'account_id': os.environ.get('R2_ACCOUNT_ID'),
        'access_key': os.environ.get('R2_ACCESS_KEY_ID'),
        'secret_key': os.environ.get('R2_SECRET_ACCESS_KEY'),
        'bucket': os.environ.get('R2_BUCKET', 'anki-content'),
    }
    
    if not creds['account_id']:
        cred_file = Path.home() / '.anki-r2' / 'credentials'
        if cred_file.exists():
            for line in cred_file.read_text().strip().split('\n'):
                if '=' in line:
                    key, value = line.split('=', 1)
                    key = key.strip().lower()
                    if key == 'r2_account_id':
                        creds['account_id'] = value.strip()
                    elif key == 'r2_access_key_id':
                        creds['access_key'] = value.strip()
                    elif key == 'r2_secret_access_key':
                        creds['secret_key'] = value.strip()
                    elif key == 'r2_bucket':
                        creds['bucket'] = value.strip()
    
    return creds


def create_aws_signature(method, bucket, key, date, access_key, secret_key):
    """Create AWS SigV4 signature for R2."""
    import hmac
    from hashlib import sha256
    
    service = 's3'
    region = 'auto'
    content_hash = 'UNSIGNED-PAYLOAD'
    
    canonical_uri = f'/{key}'
    canonical_headers = f'host:{access_key}.r2.cloudflarestorage.com\nx-amz-content-sha256:{content_hash}\nx-amz-date:{date}\n'
    signed_headers = 'host;x-amz-content-sha256;x-amz-date'
    
    canonical_request = f'{method}\n{canonical_uri}\n\n{canonical_headers}\n{signed_headers}\n{content_hash}'
    
    algorithm = 'AWS4-HMAC-SHA256'
    date_stamp = date[:8]
    credential_scope = f'{date_stamp}/{region}/{service}/aws4_request'
    string_to_sign = f'{algorithm}\n{date}\n{credential_scope}\n{sha256(canonical_request.encode()).hexdigest()}'
    
    def sign(key, msg):
        return hmac.new(key, msg.encode('utf-8'), sha256).digest()
    
    k_date = sign(('AWS4' + secret_key).encode(), date_stamp)
    k_region = sign(k_date, region)
    k_service = sign(k_region, service)
    k_signing = sign(k_service, 'aws4_request')
    signature = hmac.new(k_signing, string_to_sign.encode('utf-8'), sha256).hexdigest()
    
    return f'{algorithm} Credential={access_key}/{credential_scope}, SignedHeaders={signed_headers}, Signature={signature}'


def download_from_r2(bucket, key, creds, verbose=False):
    """Download data from R2 bucket."""
    account_id = creds['account_id']
    access_key = creds['access_key']
    secret_key = creds['secret_key']
    
    endpoint = f'https://{account_id}.r2.cloudflarestorage.com/{bucket}/{key}'
    
    amz_date = datetime.utcnow().strftime('%Y%m%dT%H%M%SZ')
    authorization = create_aws_signature('GET', bucket, key, amz_date, access_key, secret_key)
    
    req = Request(
        endpoint,
        method='GET',
        headers={
            'Authorization': authorization,
            'x-amz-content-sha256': 'UNSIGNED-PAYLOAD',
            'x-amz-date': amz_date,
        }
    )
    
    try:
        response = urlopen(req, timeout=30)
        content_gz = response.read()
        content = gzip.decompress(content_gz)
        data = json.loads(content)
        
        if verbose:
            print(f"  ✓ Downloaded {key} ({len(content_gz):,} bytes compressed)")
        
        return data
    except HTTPError as e:
        if e.code == 404:
            print(f"  ✗ Not found: {key}")
        else:
            print(f"  ✗ Failed to download {key}: {e.code} {e.reason}")
        return None


def main():
    if len(sys.argv) < 2:
        print("Usage: download-from-r2 <guid> [--verbose] [--output FILE]")
        sys.exit(1)
    
    parser = argparse.ArgumentParser()
    parser.add_argument('guid', help='Note GUID to download')
    parser.add_argument('-v', '--verbose', action='store_true', help='Show detailed output')
    parser.add_argument('-o', '--output', help='Save to file instead of stdout')
    args = parser.parse_args()
    
    creds = load_credentials()
    
    if not creds['account_id']:
        print("❌ Error: R2 credentials not found")
        sys.exit(1)
    
    key = f"notes/{args.guid}.json.gz"
    
    if args.verbose:
        print(f"📥 Downloading from R2...")
        # codeql[py/clear-text-logging-sensitive-info] Masked values used for display
        print(f"   Bucket: {mask_value(creds['bucket'])}")
        print(f"   Key: {key}")
    
    data = download_from_r2(creds['bucket'], key, creds, args.verbose)
    
    if data:
        output = json.dumps(data, indent=2, ensure_ascii=False)
        
        if args.output:
            Path(args.output).write_text(output)
            print(f"   Saved to {args.output}")
        else:
            print()
            print(output)
    else:
        print("❌ Download failed")
        sys.exit(1)


if __name__ == "__main__":
    main()
