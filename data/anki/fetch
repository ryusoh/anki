#!/usr/bin/env python3
"""
fetch - Fetch Anki stats to Git-friendly format

Usage:
    fetch [options]

Options:
    -h, --help      Show this help message
    -v, --verbose   Show detailed output
    -q, --quiet     Minimal output

Run from anywhere in the project.
"""

import sqlite3
import json
import gzip
import sys
import argparse
from pathlib import Path
from datetime import datetime


def find_project_root():
    """Find project root by looking for data/anki directory."""
    current = Path.cwd()
    
    # Check if we're already in data/anki
    if (current / "export_for_git.py").exists():
        return current
    
    # Search up the directory tree
    for parent in [current, *current.parents]:
        if (parent / "data" / "anki").exists():
            return parent / "data" / "anki"
    
    # Fallback: use script location
    script_dir = Path(__file__).parent
    if (script_dir / "export_for_git.py").exists():
        return script_dir
    
    raise RuntimeError("Could not find data/anki directory")


def fetch_and_anonymize(source_db, for_r2=False):
    """Load data from Anki DB.
    
    Args:
        source_db: Path to Anki collection DB
        for_r2: If True, also fetch full content (flds, tags) for R2 staging
    """
    conn = sqlite3.connect(source_db)
    conn.row_factory = sqlite3.Row
    cur = conn.cursor()

    # Cards with deck info
    cur.execute("""
        SELECT c.id, c.nid, c.did, c.ord, c.type, c.queue, c.due,
               c.ivl, c.factor, c.reps, c.lapses, c.flags,
               d.name as deck_name
        FROM cards c
        LEFT JOIN decks d ON c.did = d.id
    """)
    cards = [dict(row) for row in cur.fetchall()]

    # Reviews (full history)
    cur.execute("""
        SELECT id, cid, ease, ivl, lastIvl, factor, time, type
        FROM revlog
        ORDER BY id
    """)
    reviews = [dict(row) for row in cur.fetchall()]

    # Decks
    cur.execute("SELECT id, name FROM decks")
    decks = {row[0]: row[1] for row in cur.fetchall()}

    # Note types
    cur.execute("SELECT id, name FROM notetypes")
    notetypes = {row[0]: row[1] for row in cur.fetchall()}

    # Notes metadata (always anonymized for Git)
    cur.execute("""
        SELECT id, guid, mid, mod, usn, csum, flags
        FROM notes
    """)
    notes = [dict(row) for row in cur.fetchall()]

    # Fetch full content only if for_r2 is True
    notes_full = []
    if for_r2:
        cur.execute("""
            SELECT id, guid, mid, mod, usn, flds, tags, data, csum, flags
            FROM notes
        """)
        notes_full = [dict(row) for row in cur.fetchall()]

    conn.close()

    result = {
        'cards': cards,
        'reviews': reviews,
        'decks': decks,
        'notetypes': notetypes,
        'notes': notes
    }
    
    if for_r2:
        result['notes_full'] = notes_full
        # Also fetch cards with data field
        cur2 = sqlite3.connect(source_db)
        cur2.row_factory = sqlite3.Row
        cur2_cur = cur2.cursor()
        cur2_cur.execute("""
            SELECT id, nid, data
            FROM cards
            WHERE data != '' AND data IS NOT NULL
        """)
        result['cards_data'] = [dict(row) for row in cur2_cur.fetchall()]
        cur2.close()

    return result


def stage_r2_content(data, output_dir, verbose=True):
    """Stage R2 content from fetched data (already in memory).
    
    Uses incremental staging with hash map:
    - Only stages notes whose content changed
    - Tracks changes in .hash_map.json (safe for GitHub)
    
    Stages COMPLETE data for future applications:
    - notes.json.gz: All notes with full content + deck info
    - cards.json.gz: All cards with deck info
    - reviews.json.gz: Full review history
    - decks.json: Full deck configurations
    - notetypes.json.gz: Complete note type definitions
    - notes/{guid_hash}.json.gz: Individual notes (only changed)
    """
    import hashlib
    import sys
    
    # Add project root to path for graph module import
    # Script is at: data/anki/fetch
    # Graph module is at: graph/hash_map.py
    # Need to add project root (2 levels up)
    project_root = Path(__file__).parent.parent.parent
    if str(project_root) not in sys.path:
        sys.path.insert(0, str(project_root))
    
    from graph.hash_map import (
        load_hash_map,
        save_hash_map,
        find_changed_notes,
        update_hash_map,
        compute_note_hash,
    )
    
    staging_dir = output_dir.parent / "cloudflare"
    staging_dir.mkdir(exist_ok=True)
    
    # Collection files
    collection_dir = staging_dir / "collection"
    collection_dir.mkdir(exist_ok=True)
    
    # Build note -> deck map from cards
    note_to_deck = {}
    for card in data.get('cards', []):
        nid = card['nid']
        if nid not in note_to_deck:
            note_to_deck[nid] = {
                'deck': card.get('deck_name', 'Unknown'),
                'deck_id': card.get('did', 0)
            }
    
    # Add deck info to notes
    notes_with_deck = []
    notes_to_process = data.get('notes_full', data['notes'])
    for note in notes_to_process:
        note_copy = dict(note)
        nid = note.get('id')
        if nid in note_to_deck:
            note_copy['deck'] = note_to_deck[nid]['deck']
            note_copy['deck_id'] = note_to_deck[nid]['deck_id']
        else:
            note_copy['deck'] = 'Unknown'
            note_copy['deck_id'] = 0
        notes_with_deck.append(note_copy)
    
    # === COMPLETE DATA FILES WITH INCREMENTAL HASH CHECK ===

    # Load existing hash map (same location as upload-to-r2)
    hash_map_file = staging_dir / "hash_map.json"
    old_hash_map = load_hash_map(hash_map_file)

    # Helper function to check if collection file changed
    def collection_file_changed(key, content):
        """Check if collection file content changed based on hash."""
        import hashlib
        if isinstance(content, (dict, list)):
            content_str = json.dumps(content, sort_keys=True, ensure_ascii=False).encode('utf-8')
        else:
            content_str = content if isinstance(content, bytes) else str(content).encode('utf-8')
        current_hash = hashlib.sha256(content_str).hexdigest()
        old_hash = old_hash_map.get(key)
        return old_hash is None or old_hash != current_hash, current_hash

    # Track which collection files changed
    changed_files = []
    collection_hashes = {}

    # 1. notes.json.gz (full content with deck info)
    key = "collection/notes.json.gz"
    changed, current_hash = collection_file_changed(key, notes_with_deck)
    collection_hashes[key] = current_hash
    if changed:
        notes_file = collection_dir / "notes.json.gz"
        with gzip.open(notes_file, 'wt', encoding='utf-8') as f:
            json.dump(notes_with_deck, f, ensure_ascii=False)
        changed_files.append(key)
        if verbose:
            print(f"   ✓ Staged collection/notes.json.gz ({notes_file.stat().st_size:,} bytes) [CHANGED]")
    elif verbose:
        print(f"   ⊘ Skipped collection/notes.json.gz [UNCHANGED]")

    # 2. cards.json.gz (ALL cards, not just those with data field)
    key = "collection/cards.json.gz"
    changed, current_hash = collection_file_changed(key, data.get('cards', []))
    collection_hashes[key] = current_hash
    if changed:
        cards_file = collection_dir / "cards.json.gz"
        with gzip.open(cards_file, 'wt', encoding='utf-8') as f:
            json.dump(data.get('cards', []), f, ensure_ascii=False)
        changed_files.append(key)
        if verbose:
            print(f"   ✓ Staged collection/cards.json.gz ({cards_file.stat().st_size:,} bytes) [CHANGED]")
    elif verbose:
        print(f"   ⊘ Skipped collection/cards.json.gz [UNCHANGED]")

    # 3. reviews.json.gz (complete review history)
    key = "collection/reviews.json.gz"
    changed, current_hash = collection_file_changed(key, data.get('reviews', []))
    collection_hashes[key] = current_hash
    if changed:
        reviews_file = collection_dir / "reviews.json.gz"
        with gzip.open(reviews_file, 'wt', encoding='utf-8') as f:
            json.dump(data.get('reviews', []), f, ensure_ascii=False)
        changed_files.append(key)
        if verbose:
            print(f"   ✓ Staged collection/reviews.json.gz ({reviews_file.stat().st_size:,} bytes) [CHANGED]")
    elif verbose:
        print(f"   ⊘ Skipped collection/reviews.json.gz [UNCHANGED]")

    # 4. decks.json (deck list)
    key = "collection/decks.json"
    changed, current_hash = collection_file_changed(key, data.get('decks', {}))
    collection_hashes[key] = current_hash
    if changed:
        decks_file = collection_dir / "decks.json"
        with open(decks_file, 'w', encoding='utf-8') as f:
            json.dump(data.get('decks', {}), f, ensure_ascii=False, indent=2)
        changed_files.append(key)
        if verbose:
            print(f"   ✓ Staged collection/decks.json ({decks_file.stat().st_size:,} bytes) [CHANGED]")
    elif verbose:
        print(f"   ⊘ Skipped collection/decks.json [UNCHANGED]")

    # 5. notetypes.json.gz (complete note type definitions)
    key = "collection/notetypes.json.gz"
    changed, current_hash = collection_file_changed(key, data.get('notetypes', []))
    collection_hashes[key] = current_hash
    if changed:
        notetypes_file = collection_dir / "notetypes.json.gz"
        with gzip.open(notetypes_file, 'wt', encoding='utf-8') as f:
            json.dump(data.get('notetypes', []), f, ensure_ascii=False)
        changed_files.append(key)
        if verbose:
            print(f"   ✓ Staged collection/notetypes.json.gz ({notetypes_file.stat().st_size:,} bytes) [CHANGED]")
    elif verbose:
        print(f"   ⊘ Skipped collection/notetypes.json.gz [UNCHANGED]")

    # 6. cards-data.json.gz (subset: cards with custom data field)
    cards_data = data.get('cards_data', [])
    if cards_data:
        key = "collection/cards-data.json.gz"
        changed, current_hash = collection_file_changed(key, cards_data)
        collection_hashes[key] = current_hash
        if changed:
            cards_data_file = collection_dir / "cards-data.json.gz"
            with gzip.open(cards_data_file, 'wt', encoding='utf-8') as f:
                json.dump(cards_data, f, ensure_ascii=False)
            changed_files.append(key)
            if verbose:
                print(f"   ✓ Staged collection/cards-data.json.gz ({cards_data_file.stat().st_size:,} bytes) [CHANGED]")
        elif verbose:
            print(f"   ⊘ Skipped collection/cards-data.json.gz [UNCHANGED]")

    if verbose and changed_files:
        print(f"\n   Changed collection files: {len(changed_files)}/6")

    # === INCREMENTAL STAGING FOR INDIVIDUAL NOTES ===
    # Use same hash map as collection files (already loaded above)

    # Find changed notes
    changed_notes, unchanged_notes = find_changed_notes(notes_with_deck, old_hash_map)

    if verbose:
        print(f"\n   📊 Incremental staging:")
        print(f"      Total notes: {len(notes_with_deck):,}")
        print(f"      Changed/new: {len(changed_notes):,} ({len(changed_notes)/len(notes_with_deck)*100:.1f}%)")
        print(f"      Unchanged: {len(unchanged_notes):,} ({len(unchanged_notes)/len(notes_with_deck)*100:.1f}%)")
        print(f"\n   Staging {len(changed_notes):,} changed/new individual notes...")

    # Stage only changed notes
    notes_dir = staging_dir / "notes"
    notes_dir.mkdir(exist_ok=True)

    # Copy unchanged notes from existing staging (if any)
    if unchanged_notes and notes_dir.exists():
        if verbose:
            print(f"   Copying {len(unchanged_notes):,} unchanged notes from previous staging...")
        # Keep existing files for unchanged notes

    errors = []
    for i, note in enumerate(changed_notes, 1):
        try:
            guid_hash = hashlib.md5(note['guid'].encode()).hexdigest()[:16]
            note_file = notes_dir / f"{guid_hash}.json.gz"
            with gzip.open(note_file, 'wt', encoding='utf-8') as f:
                json.dump(note, f, ensure_ascii=False)
        except Exception as e:
            errors.append((note.get('guid', 'unknown'), str(e)))
        
        # Show progress every 100 files (fast enough to not slow down, frequent enough to see movement)
        if verbose and i % 100 == 0:
            progress = (i / len(changed_notes)) * 100
            bar_width = 40
            filled = int(bar_width * i / len(changed_notes))
            bar = '█' * filled + '░' * (bar_width - filled)
            # Use carriage return to update in place
            print(f"\r   [{bar}] {i:,}/{len(changed_notes):,} ({progress:.1f}%)", end='', flush=True)

    # Report errors
    if errors:
        print(f"\n   ⚠️  {len(errors)} error(s) while staging notes:")
        for guid, error in errors[:10]:
            print(f"      - {guid}: {error}")
        if len(errors) > 10:
            print(f"      ... and {len(errors) - 10} more")
        print(f"   ⚠️  Some notes were NOT staged - check errors above")

    # Newline after completion
    if verbose:
        print()

    # DO NOT update hash map here - upload-to-r2 will do it after successful upload
    # If we update here, upload-to-r2 won't know what needs to be uploaded
    notes_staged = len(changed_notes) - len(errors)
    if verbose:
        print(f"\n   ✅ Staged {notes_staged:,}/{len(changed_notes):,} changed/new notes")
        if errors:
            print(f"   ⚠️  {len(errors)} note(s) failed to stage")
        print(f"   💾 Hash map will be updated after upload to R2")
        print(f"\n   📦 Complete R2 staging includes:")
        print(f"      - notes.json.gz (with deck info)")
        print(f"      - cards.json.gz (all cards)")
        print(f"      - reviews.json.gz (full history)")
        print(f"      - decks.json (deck list)")
        print(f"      - notetypes.json.gz (templates)")
        print(f"      - Individual notes/ ({notes_staged:,} changed + unchanged from cache)")


def files_are_identical(new_data, existing_file):
    """Check if new data is identical to existing file content."""
    if not existing_file.exists():
        return False
    
    import io
    try:
        with gzip.open(existing_file, 'rt', encoding='utf-8') as f:
            existing_data = f.read()
        
        new_json = json.dumps(new_data, ensure_ascii=False)
        return existing_data == new_json
    except Exception:
        return False


def export_for_git(data, output_dir, verbose=True):
    """Export data in Git-friendly format.

    Only writes files if content has changed to minimize Git diffs.
    """

    files_created = []
    files_unchanged = []

    # Export cards (current snapshot - check if changed)
    cards_file = output_dir / "cards.json.gz"
    if files_are_identical(data['cards'], cards_file):
        files_unchanged.append('cards.json.gz')
    else:
        with gzip.open(cards_file, 'wt', encoding='utf-8') as f:
            json.dump(data['cards'], f, ensure_ascii=False)
        files_created.append(('cards.json.gz', cards_file.stat().st_size, len(data['cards'])))

    # Export notes (current snapshot - check if changed)
    notes_file = output_dir / "notes.json.gz"
    if files_are_identical(data['notes'], notes_file):
        files_unchanged.append('notes.json.gz')
    else:
        with gzip.open(notes_file, 'wt', encoding='utf-8') as f:
            json.dump(data['notes'], f, ensure_ascii=False)
        files_created.append(('notes.json.gz', notes_file.stat().st_size, len(data['notes'])))

    # Export decks (always update - small file)
    decks_file = output_dir / "decks.json"
    with open(decks_file, 'w', encoding='utf-8') as f:
        json.dump(data['decks'], f, ensure_ascii=False, indent=2)
    files_created.append(('decks.json', decks_file.stat().st_size, len(data['decks'])))

    # Export reviews partitioned by month
    reviews_dir = output_dir / "reviews"
    reviews_dir.mkdir(exist_ok=True)

    # Group reviews by YYYY-MM
    reviews_by_month = {}
    for review in data['reviews']:
        ts = review['id'] / 1000
        dt = datetime.fromtimestamp(ts)
        month_key = dt.strftime('%Y-%m')

        if month_key not in reviews_by_month:
            reviews_by_month[month_key] = []
        reviews_by_month[month_key].append(review)

    # Write each month to separate file ONLY if content changed
    for month, reviews in sorted(reviews_by_month.items()):
        month_file = reviews_dir / f"{month}.json.gz"
        
        # Check if file content is identical
        if files_are_identical(reviews, month_file):
            files_unchanged.append(f'reviews/{month}.json.gz')
        else:
            with gzip.open(month_file, 'wt', encoding='utf-8') as f:
                json.dump(reviews, f, ensure_ascii=False)
            files_created.append((f'reviews/{month}.json.gz', month_file.stat().st_size, len(reviews)))

    return files_created, files_unchanged


def main():
    parser = argparse.ArgumentParser(
        prog='fetch',
        description='Fetch Anki stats to Git-friendly format',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
    fetch                 # Full output
    fetch -q              # Minimal output  
    fetch --verbose       # Detailed output
        """
    )
    parser.add_argument('-v', '--verbose', action='store_true', help='Show detailed output')
    parser.add_argument('-q', '--quiet', action='store_true', help='Minimal output')
    parser.add_argument('--stage-r2', action='store_true', help='Also stage R2 private content')

    args = parser.parse_args()
    verbose = args.verbose and not args.quiet
    quiet = args.quiet
    
    try:
        output_dir = find_project_root()
    except RuntimeError as e:
        print(f"❌ Error: {e}", file=sys.stderr)
        sys.exit(1)
    
    # Find Anki profile directory
    ankis = list(Path("/Users/lz/Library/Application Support/Anki2").glob("*/collection.anki2"))
    if not ankis:
        print("❌ No Anki collection found", file=sys.stderr)
        sys.exit(1)
    
    # Use first found (or could add profile selection)
    anki_profile_dir = ankis[0].parent
    source_db = anki_profile_dir / "collection.anki2"
    
    if not quiet:
        print("📦 Fetching Anki collection...")
        if verbose:
            print(f"   Source: {source_db}")
            print(f"   Output: {output_dir}")
    
    # Copy DB to temp location
    import shutil
    temp_db = output_dir / "collection.anki2"
    shutil.copy2(source_db, temp_db)
    
    try:
        # Fetch and export (with full content if staging for R2)
        data = fetch_and_anonymize(temp_db, for_r2=args.stage_r2)
        files_created, files_unchanged = export_for_git(data, output_dir, verbose)

        # Optionally stage R2 private content (uses data already in memory)
        if args.stage_r2:
            print()
            print("📦 Staging R2 private content...")
            stage_r2_content(data, output_dir, verbose)

        # Generate custom stats for terminal
        print()
        print("📊 Generating terminal stats...")
        import subprocess
        result = subprocess.run(
            ["python3", str(output_dir / "generate_custom_stats.py")],
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            print(result.stdout.strip())
        else:
            print(f"   ⚠️  Stats generation failed: {result.stderr.strip()}")
        
        # Generate review stats for terminal
        print()
        print("📊 Generating review stats...")
        result = subprocess.run(
            ["python3", str(output_dir / "generate_review_stats.py")],
            capture_output=True,
            text=True
        )
        if result.returncode == 0:
            print(result.stdout.strip())
        else:
            print(f"   ⚠️  Review stats generation failed: {result.stderr.strip()}")

        # Summary
        total_size = sum(f[1] for f in files_created)
        total_reviews = data['reviews'].__len__() if 'reviews' in data else sum(f[2] for f in files_created if 'reviews' in f[0])

        if quiet:
            new_count = len(files_created)
            unchanged_count = len(files_unchanged)
            if unchanged_count > 0:
                print(f"✓ {new_count} new/changed, {unchanged_count} unchanged")
            else:
                print(f"✓ {new_count} files, {total_size/1024/1024:.1f} MB")
        else:
            print()
            if files_created:
                for name, size, count in files_created:
                    if 'reviews' in name:
                        print(f"   ✓ {name} ({size/1024:.1f} KB, {count:,} reviews)")
                    else:
                        print(f"   ✓ {name} ({size/1024:.1f} KB)")
            
            if files_unchanged and verbose:
                print()
                print(f"   = {len(files_unchanged)} review files unchanged (skipped)")

            print()
            print(f"✅ Done! ({total_size/1024/1024:.1f} MB new/changed, {total_reviews:,} reviews)")
            if files_unchanged:
                print(f"   {len(files_unchanged)} historical months unchanged")
            print()
            print("📝 Commit with:")
            print("   git add data/anki/ && git commit -m 'Update Anki stats'")
    
    finally:
        # Cleanup temp DB
        temp_db.unlink(missing_ok=True)
        (output_dir / "collection.anki2-shm").unlink(missing_ok=True)
        (output_dir / "collection.anki2-wal").unlink(missing_ok=True)


if __name__ == "__main__":
    main()
