{
  "name": "anki",
  "type": "module",
  "imports": {
    "#js/*": "./js/*",
    "#ui/*": "./js/ui/*"
  },
  "scripts": {
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest"
  },
  "dependencies": {
    "jsdom": "27.0.0"
  },
  "overrides": {
    "undici": "^7.28.0",
    "@asamuzakjp/css-color": "4.1.0",
    "fast-uri": "^4.1.2",
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "stylelint": "^17.14.1",
    "typescript": "^7.0.2"
  },
  "jest": {
    "roots": [
      "<rootDir>/review_heatmap/tests"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/",
      "<rootDir>/.venv/"
    ]
  },
  "c8": {
    "lines": 70,
    "branches": 90,
    "functions": 85,
    "statements": 70
  }
}
