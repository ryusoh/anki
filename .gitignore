# =============================================================================
# R2 / Cloudflare (Private Content - Never GitHub)
# =============================================================================
# Credentials (never commit!)
~/.anki-r2/
.anki-r2/
*.anki-r2

# Staging directory (temporary before upload)
# Note: hash_map.json is tracked (force added), other files ignored below
data/cloudflare/notes/
data/cloudflare/collection/

# Graph output (contains merged private data)
graph_output/

# Hash map for incremental staging (OPTIONAL - can commit for multi-machine sync)
# Contains: GUID -> SHA256(flds+tags+mid) mappings
#
# To commit (recommended for multi-machine use):
#   git add data/cloudflare/hash_map.json
#   git commit -m "Add hash map for incremental R2 uploads"
#
# To keep local only:
#   Keep this in .gitignore, backup via Time Machine
#   Regenerate: python3 data/anki/migrate-hash-map.py
#
# Privacy: SHA256 hashes can't be reversed, GUIDs are in your Anki DB already
.hash_map.json
# data/cloudflare/hash_map.json  # Uncomment to allow committing

# R2 private data files (full content, never GitHub)
data/anki/cards-data.json.gz
data/anki/notetypes.json.gz
data/anki/decks-config.json.gz
data/anki/media-registry.json
data/anki/collection-config.json

# =============================================================================
# Temporary Anki data
# =============================================================================
data/anki/collection.anki2
data/anki/collection.anki2-shm
data/anki/collection.anki2-wal

# =============================================================================
# Anki Data (GitHub-safe anonymized versions only)
# =============================================================================
# These are generated by fetch and are safe for GitHub:
# - data/anki/notes.json.gz (no flds, no tags)
# - data/anki/cards.json.gz (scheduling only)
# - data/anki/decks.json (names only)
# - data/anki/reviews/*.json.gz (review history)

