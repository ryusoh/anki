# Coverage config for the Python test suites. See the `check-py` Makefile
# target: it runs each addon's tests as a separate pytest invocation and
# accumulates coverage with --cov-append, then prints one report. This mirrors
# the JS coverage report produced by `check-node` (c8).
[run]
branch = True
omit =
    */tests/*
    tests/*
    tools/test_*.py
    conftest.py
    */__pycache__/*

[report]
show_missing = True
# Whole-suite coverage floor (docs/lint-and-quality.md): measured 77% on
# 2026-07-26 (branch coverage, `make check-py`). Set slightly below the
# measured value; ratchet upward as coverage improves, never down. `coverage
# report` exits non-zero below the floor, which `check-py` turns into a gate
# failure.
fail_under = 75
